            onClick={openUploadModal}
            title={isCustom ? 'Reemplazar logotipo corporativo cargado' : 'Cargar logotipo desde este equipo'}
            aria-label="Cargar logotipo desde equipo"
            className={`w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-xl border transition active:scale-95 ${
              isCustom
                ? 'bg-emerald-950/60 border-emerald-500/60 text-emerald-400 hover:bg-emerald-900/60 shadow-sm'
                : theme === 'dark'
                ? 'bg-slate-800 border-slate-700 text-slate-300 hover:text-emerald-400 hover:bg-slate-700'
                : 'bg-slate-100 border-slate-300 text-slate-700 hover:text-emerald-600 hover:bg-slate-200 shadow-sm'
            }`}
          >
            <Upload className="w-5 h-5" />
          </button>

          <div className={`hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono ${
            theme === 'dark' ? 'bg-slate-950 border-slate-800' : 'bg-slate-50 border-slate-200'
          }`}>
            {syncStatus.isOnline ? (
              <>
                <Wifi className="w-3.5 h-3.5 text-emerald-500 animate-pulse" />
                <span className="text-emerald-600 dark:text-emerald-400 font-semibold">ONLINE</span>
              </>
            ) : (
              <>
                <WifiOff className="w-3.5 h-3.5 text-amber-500" />
                <span className="text-amber-600 dark:text-amber-400 font-semibold">OFFLINE</span>
              </>
            )}
          </div>

          <div className="flex items-center gap-2">
            <div className={`text-right hidden sm:block ${theme === 'dark' ? 'text-slate-300' : 'text-slate-700'}`}>
              <div className="text-xs font-semibold">{userProfile?.email}</div>
              <div className="text-[10px] font-mono text-emerald-500 uppercase font-bold tracking-wider">
                {role}
              </div>
            </div>

            <button
              onClick={onSignOutClick}
              disabled={isPurging}
              title={confirmSignOut ? 'Toca nuevamente para cerrar sesión' : 'Cerrar Sesión'}
              className={`min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 shadow-xs cursor-pointer ${
                confirmSignOut
                  ? 'bg-red-600 hover:bg-red-500 text-white animate-pulse'
                  : theme === 'dark'
                  ? 'bg-red-950/60 hover:bg-red-900/60 text-red-300 border border-red-800/80'
                  : 'bg-red-50 hover:bg-red-100 text-red-600 border border-red-200'
              }`}
            >
              <LogOut className="w-4 h-4 shrink-0" />
              <span className="hidden md:inline font-sans">
                {isPurging ? 'Saliendo...' : confirmSignOut ? '¿Confirmar Salida?' : 'Salir'}
              </span>
            </button>
          </div>
        </div>
      </header>

      {/* Mobile Drawer Menu */}
      {mobileMenuOpen && (
        <div className="md:hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xs flex flex-col justify-end animate-in fade-in">
          <div className={`p-5 rounded-t-3xl border-t space-y-4 max-h-[85vh] overflow-y-auto ${
            theme === 'dark' ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'
          }`}>
            <div className="flex items-center justify-between pb-3 border-b border-slate-800">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400">
                Módulos de Producción
              </span>
              <button
                type="button"
                onClick={() => setMobileMenuOpen(false)}
                className="w-11 h-11 flex items-center justify-center text-slate-400 hover:text-white"
              >
                <X className="w-6 h-6" />
              </button>
            </div>

            <div className="grid grid-cols-1 gap-2">
              {navModules.map((m) => {
                const Icon = m.icon;
                const isActive = activeModule === m.id;
                return (
                  <button
                    key={m.id}
                    onClick={() => {
                      setActiveModule(m.id);
                      setMobileMenuOpen(false);
                    }}
                    className={`flex items-center justify-between p-3.5 rounded-2xl text-xs font-bold transition ${
                      isActive
                        ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-950/50'
                        : theme === 'dark'
                        ? 'bg-slate-950 hover:bg-slate-800 text-slate-300'
                        : 'bg-slate-100 hover:bg-slate-200 text-slate-800'
                    }`}
                  >
                    <div className="flex items-center gap-3">
                      <Icon className="w-5 h-5" />
                      <span>{m.label}</span>
                    </div>
                    <span className="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-900/60 border border-slate-700/60">
                      {m.badge}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* Main Workspace with Adaptive Navigation */}
      <div className="flex flex-1 overflow-hidden">
        {/* Desktop Sidebar Navigation */}
        <aside className={`w-64 border-r p-4 hidden md:flex flex-col justify-between shrink-0 transition-colors ${
          theme === 'dark' ? 'bg-slate-900/50 border-slate-800' : 'bg-white border-slate-200'
        }`}>
          <div className="space-y-1.5">
            <div className="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-bold px-3 py-1">
              Módulos del Sistema
            </div>
            {navModules.map((m) => {
              const Icon = m.icon;
              const isActive = activeModule === m.id;
              return (
                <button
                  key={m.id}
                  onClick={() => setActiveModule(m.id)}
                  className={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition min-h-[44px] cursor-pointer ${
                    isActive
                      ? 'bg-emerald-600 text-white shadow-md shadow-emerald-950/30'
                      : theme === 'dark'
                      ? 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'
                      : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
                  }`}
                >
                  <div className="flex items-center gap-2.5">
                    <Icon className="w-4 h-4 shrink-0" />
                    <span className="truncate">{m.label}</span>
                  </div>
                  <span className={`text-[9px] font-mono px-1.5 py-0.5 rounded ${
                    isActive ? 'bg-emerald-700 text-white' : 'bg-slate-800 text-slate-400'
                  }`}>
                    {m.badge}
                  </span>
                </button>
              );
            })}
          </div>

          <div className="pt-4 border-t border-slate-800 text-[11px] font-mono text-slate-500 space-y-1">
            <div className="flex items-center justify-between">
              <span>Sincronizador:</span>
              <span className="text-emerald-500 font-bold">Activo</span>
            </div>
            <div className="flex items-center justify-between">
              <span>Modo Base:</span>
              <span>Bimonetario BCV</span>
            </div>
          </div>
        </aside>

        {/* Dynamic Content View Container */}
        <main className="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
          {activeModule === 'PANEL_CONTROL' && <ConsolidatedExecutiveDashboard />}
          {activeModule === 'INVENTARIOS' && <InventoryManagement />}
          {activeModule === 'FINANZAS' && <FinancialLedger />}
          {activeModule === 'RRHH' && <HumanResourcesDashboard />}
          {activeModule === 'ANALITICA' && <FinancialAnalytics />}
          {activeModule === 'GOBERNANZA' && <GovernanceIAM />}
          {activeModule === 'AUDITORIA' && <DevSecOpsAudit />}

          {/* CRM & Clon de WhatsApp Web en Vivo - Bloqueado para OBRERO */}
          {activeModule === 'CRM' && (
            <AuthGuard
              requiredRole="ADMIN"
              disallowedRoles={['OBRERO']}
              resourceName="CRM & WhatsApp Web en Vivo"
              onRedirectToDefault={() => setActiveModule('INVENTARIOS')}
            >
              <React.Suspense
                fallback={
                  <div className="flex items-center justify-center min-h-[400px] text-emerald-400 gap-2">
                    <RefreshCw className="w-5 h-5 animate-spin" />
                    <span className="text-sm font-semibold">Cargando WhatsApp Web CRM...</span>
                  </div>
                }
              >
                <WhatsAppWebCloneView
                  entities={crmEntities}
                  invoices={crmInvoices}
                  bcvRate={crmBcvRate}
                  onAnalyzeReceiptOCR={(dataUrl, contact) => {
                    setCrmOcrImageDataUrl(dataUrl);
                    setCrmOcrClientPhone(contact?.telefonoE164);
                    setCrmOcrModalOpen(true);
                  }}
                  onNavigateToFinance={() => setActiveModule('FINANZAS')}
                />
              </React.Suspense>
            </AuthGuard>
          )}

          {activeModule === 'ESQUEMAS' && isSuperAdmin && <SchemaBuilder />}

          {/* Sub-módulo: Telemetría Sync & Offline Testing */}
          {activeModule === 'TELEMETRIA' && (
            <div className="space-y-6 max-w-5xl mx-auto">
              <div className="p-6 bg-slate-900 border border-slate-800 rounded-3xl space-y-4">
                <h2 className="text-base font-bold text-white flex items-center gap-2">
                  <Activity className="w-5 h-5 text-cyan-400" />
                  <span>Telemetría de la Cola Offline-First</span>
                </h2>
                <p className="text-xs text-slate-400">
                  Inspección y pruebas de estrés de IndexedDB con ciclo Debounce de 30 segundos.
                </p>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <div className="p-3 bg-slate-950 rounded-2xl border border-slate-800">
                    <span className="text-[10px] text-slate-500 uppercase block font-bold">En Cola</span>
                    <strong className="text-lg font-mono text-cyan-400">{syncStatus.pendingCount}</strong>
                  </div>
                  <div className="p-3 bg-slate-950 rounded-2xl border border-slate-800">
                    <span className="text-[10px] text-slate-500 uppercase block font-bold">Estado</span>
                    <strong className="text-lg font-mono text-white">{syncStatus.mode}</strong>
                  </div>
                  <div className="p-3 bg-slate-950 rounded-2xl border border-slate-800">
                    <span className="text-[10px] text-slate-500 uppercase block font-bold">Cuenta Regresiva</span>
                    <strong className="text-lg font-mono text-amber-400">{syncStatus.nextSyncCountdownSeconds}s</strong>
                  </div>
                  <div className="p-3 bg-slate-950 rounded-2xl border border-slate-800">
                    <span className="text-[10px] text-slate-500 uppercase block font-bold">Bytes Ahorrados</span>
                    <strong className="text-lg font-mono text-emerald-400">{syncStatus.totalSavedBytes} B</strong>
                  </div>
                </div>

                <div className="flex flex-wrap gap-2 pt-2">
                  <button
                    onClick={handleTestEnqueue}
                    className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-xl min-h-[44px]"
                  >
                    Simular Mutación en Cola
                  </button>
                  <button
                    onClick={handleSimulateTyping}
                    className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-xl min-h-[44px]"
                  >
                    Simular Tipeo (Debounce 30s)
                  </button>
                  <button
                    onClick={handleManualFlush}
                    className="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-semibold rounded-xl min-h-[44px]"
                  >
                    Forzar Vaciado Inmediato
                  </button>
                </div>

                {testLog.length > 0 && (
                  <div className="p-3 bg-slate-950 rounded-2xl border border-slate-800 space-y-1 font-mono text-[11px] text-slate-300">
                    {testLog.map((log, i) => (
                      <div key={i}>{log}</div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )}
        </main>
      </div>

      {/* Floating Smart Assistant */}
      <FloatingAIAssistant />

      {/* Startup Alerts Modal */}
      <StartupAlertsModal
        isOpen={isAlertsModalOpen}
        onClose={closeAlertsModal}
        digest={digest}
        onSnooze24h={snoozeAlerts24h}
        userRole={role}
      />

      {/* Modal de Lectura Forense OCR invocado directamente desde WhatsApp Web */}
      {crmOcrModalOpen && (
        <React.Suspense fallback={null}>
          <LectorComprobanteOCRModal
            isOpen={crmOcrModalOpen}
            onClose={() => {
              setCrmOcrModalOpen(false);
              setCrmOcrImageDataUrl(null);
              setCrmOcrClientPhone(undefined);
            }}
            initialImageDataUrl={crmOcrImageDataUrl}
            initialClientPhone={crmOcrClientPhone}
            entities={crmEntities}
            invoices={crmInvoices}
            bcvRate={crmBcvRate}
            onPaymentReconciled={() => {
              addLog('Pago conciliado y cruzado exitosamente desde WhatsApp CRM.');
            }}
          />
        </React.Suspense>
      )}

      {/* Footer Legal Oficial */}
      <footer className="py-3 px-6 border-t border-slate-800/60 bg-slate-950/80 text-center text-xs text-slate-500 font-mono">
        Derechos de desarrollo reservados a AR Group 2026
      </footer>
    </div>
  );
};

    const reader = new FileReader();
    reader.onload = async () => {
      const dataUri = reader.result as string;
      await WhatsAppCloneService.sendWhatsAppMessage(
        activeLineId,
        activeLine?.numeroTelefono || '+584140000001',
        selectedContactPhone,
        `[Adjunto: ${file.name}]`,
        'IMAGEN',
        dataUri,
        file.type
      );
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  };


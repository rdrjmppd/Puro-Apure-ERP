  const selectedContact = useMemo(() => {
    return (
      contactList.find((c) => c.telefonoE164 === selectedContactPhone) ||
      (selectedContactPhone
        ? WhatsAppCloneService.enrichContactWithERP(selectedContactPhone, entities)

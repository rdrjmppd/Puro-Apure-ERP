                        >
                          <span>{isConciliado ? 'Ver Registro' : 'Revisar y Conciliar'}</span>
                          <ArrowUpRight className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};
